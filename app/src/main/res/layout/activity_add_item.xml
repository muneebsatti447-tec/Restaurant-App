<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical"
    tools:context=".AddItemActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add New Food Item"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"/>

    <!-- Item Name -->
    <EditText
        android:id="@+id/etItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Item Name (e.g., Zinger Burger)"
        android:inputType="textCapWords"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/custom_edittext_bg"/>

    <!-- Item Description -->
    <EditText
        android:id="@+id/etItemDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Description (e.g., Crispy chicken with mayo)"
        android:inputType="textCapSentences"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/custom_edittext_bg"/>

    <!-- Item Price -->
    <EditText
        android:id="@+id/etItemPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Price (e.g., 550)"
        android:inputType="numberDecimal"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/custom_edittext_bg"/>

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Item"
        android:padding="16dp"
        android:textSize="18sp"/>

</LinearLayout>
